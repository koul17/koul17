<TrafficSignApp>:
    orientation: 'vertical'
    img_widget: img_widget
    label: label
    btn: btn
    KivyImage:
        id: img_widget
        size_hint: 1, 0.7
    Label:
        id: label
        text: 'اضغط على زر المسح لمسح رمز QR'
        size_hint: 1, 0.1
    Button:
        id: btn
        text: 'مسح رمز QR'
        size_hint: 1, 0.2
